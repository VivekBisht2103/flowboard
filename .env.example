# Copy to .env to override. No real secrets: these are local-dev defaults.
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=flowboard
POSTGRES_DB=flowboard

# Host ports
WEB_PORT=3000
API_PORT=8080
DB_PORT=5432

# Auth (mock identity). Turn AUTH_ALLOW_HEADER off to require JWTs only.
JWT_SECRET=change-me-for-anything-but-local
JWT_TTL=15m
AUTH_ALLOW_HEADER=true
AUTH_DEV_ISSUER=true

# Outbound webhooks (worker -> webhook-sink demo receiver)
WEBHOOK_URL=http://webhook-sink:9090/hooks
WEBHOOK_SECRET=dev-webhook-secret
